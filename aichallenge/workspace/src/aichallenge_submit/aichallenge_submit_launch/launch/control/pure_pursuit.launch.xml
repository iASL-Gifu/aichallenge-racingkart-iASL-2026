<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="simulation" default="true"/>
  <arg name="use_sim_time" default="true"/>

  <let name="steering_tire_angle_gain_var" value="[1.55, 1.55, 1.55, 1.55, 1.55, 1.55, 1.50, 1.50, 1.50]" if="$(var simulation)"/>
  <let name="steering_tire_angle_gain_var" value="[1.639, 1.639, 1.639, 1.639, 1.639, 1.639, 1.639, 1.639, 1.639]" unless="$(var simulation)"/>

  <node pkg="simple_pure_pursuit" exec="simple_pure_pursuit" name="simple_pure_pursuit_node" output="screen">
    <param name="use_external_target_vel" value="true"/>
    <param name="external_target_vel" value="10.0"/>
    <param name="lookahead_gain" value="0.5"/>
    <param name="lookahead_min_distance" value="3.5"/>
    <param name="speed_proportional_gain_1" value="10.0"/>
    <param name="speed_proportional_gain_2" value="5.0"/>
    <param name="high_acceleration_speed_threshold" value="8.0"/>
    <param name="steering_tire_angle_gain" value="$(var steering_tire_angle_gain_var)"/>
    <!-- 追加した部分 -->
    <param name="lookahead_distance_1" value="[6.5, 5.5, 7.0, 5.5, 4.5, 4.5, 4.5, 6.0, 11.0]"/>
    <param name="lookahead_distance_2" value="[6.5, 5.5, 7.0, 5.5, 4.5, 4.5, 4.5, 6.0, 11.0]"/>
    <param name="steering_angle_to_lookahead_ratio" value="4.0"/>
    <param name="adaptive_gain_steering_threshold" value="0.28"/>
    <param name="adaptive_gain_lookahead_threshold" value="5.0"/>
    <param name="adaptive_gain_reduction_ratio" value="1.0"/>

    <remap from="input/kinematics" to="/localization/kinematic_state"/>
    <remap from="input/trajectory" to="/planning/scenario_planning/trajectory"/>
    <remap from="output/control_cmd" to="/control/command/control_cmd"/>
  </node>
</launch>
